# Dockerfile.frontend
# 前端镜像：多阶段构建（npm ci 依赖 → next build standalone → node 运行）。
#
# 说明：
#   - BACKEND_URL 构建时注入：Next rewrites 在 build 阶段固化进 routes manifest，
#     容器编排中为 http://backend:8080；本地构建默认 http://localhost:8080
#   - standalone 产物需手工补 .next/static 与 public 目录

# ---------- 依赖阶段 ----------
FROM node:22-alpine AS deps

WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# ---------- 构建阶段 ----------
FROM node:22-alpine AS build

ARG BACKEND_URL=http://localhost:8080
ENV BACKEND_URL=${BACKEND_URL}
# 大世界（中继站聚合流）测试开关：中继站无 TLS 时放行 http: 图片外链（生产保持 https-only）
ARG ALLOW_HTTP_IMAGES=false
ENV ALLOW_HTTP_IMAGES=${ALLOW_HTTP_IMAGES}
WORKDIR /src/frontend
COPY --from=deps /src/frontend/node_modules ./node_modules
COPY frontend/ .
# 仓库根 docs/ 一并暂存：插件参考手册（/plugin-reference）运行时读取 docs/ 下的
# markdown 源文件，镜像需携带（下一阶段复制到 /docs）。
COPY docs /src/docs
RUN npm run build

# ---------- 运行阶段 ----------
FROM node:22-alpine

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

WORKDIR /app
COPY --from=build /src/frontend/.next/standalone ./
COPY --from=build /src/frontend/.next/static ./.next/static
COPY --from=build /src/frontend/public ./public
# 插件参考手册的 markdown 源：运行时 cwd 为 /app，lib/plugin-reference.ts 按
# process.cwd()/../docs（即 /docs）定位 docs 目录，必须放在该绝对路径。
COPY --from=build /src/docs /docs

EXPOSE 3000

CMD ["node", "server.js"]
