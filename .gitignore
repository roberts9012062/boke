# 环境变量与密钥（禁止提交，含数据库密码与 GitHub Token）
.env

# 运行日志（规则要求统一输出到 logs/）
logs/

# 服务 PID 文件（scripts 启停脚本生成）
.pids/

# 本地媒体数据（media 上传目录）
data/media/

# Go 构建产物
dist/
bin/
*.exe
*.test

# 依赖目录（frontend/ 与 browser-extension/ 各自安装）
node_modules/

# 浏览器自动化调试产物（Playwright MCP 控制台日志）
.playwright-mcp/

# 本地数据库文件（如后续引入 SQLite）
*.db
*.sqlite

# 截图比对产物（Playwright 截图脚本生成）
screenshots/

# 敏感与本机环境（禁止提交）
# 注意：gitignore 规则不带行内注释（历史教训：行内中文注释导致规则不生效）
ssh-config.toml
.mcp.json
.zcode/

# 设计稿大文件（44MB+ 不随仓库分发，README 说明获取方式）
UI设计/
boke.pen
export.zip

# 内部文档（架构等，不随开源仓库分发）；插件开发手册例外——第三方插件作者需要
docs/*
!docs/plugin-development.md
!docs/browser-extension-guide.md

# 备份导出产物（data/backup/，M4-报表）
data/backup/

# 插件安装产物（data/plugins/，M3.3 二进制 + M3.4 .bpk 解包内容）
data/plugins/

# demo 插件许可证密钥（data/demo-keys/，M3.5 私钥/许可证不入库）
data/demo-keys/

# DSH 框架目录（非项目代码）
dsh-reverse-security/


# market root signing keys (P1 package signature, never commit)
data/keys/

# 插件库工作副本（源码/清单/README 归 yueyan-plugins 仓库，经 push-marketplace-repo.sh 同步）
marketplace-repo/

# GUI 测试截图（浏览器验证产物）
gui-test-screenshots/

# 本地运行产物（wrangler 缓存；data 运行目录含凭据，一律不入库）
.wrangler/
data/
nav-categories-before-check.png
