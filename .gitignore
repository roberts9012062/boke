# 环境变量与密钥（禁止提交，含数据库密码与 GitHub Token）
.env

# 运行日志（规则要求统一输出到 logs/）
logs/

# 服务 PID 文件（scripts 启停脚本生成）
.pids/

# 本地媒体数据（media 上传目录）
data/media/

# Go 构建产物
dist/
bin/
*.exe
*.test

# 本地数据库文件（如后续引入 SQLite）
*.db
*.sqlite

# 截图比对产物（Playwright 截图脚本生成）
screenshots/

# 敏感与本机环境（禁止提交）
# 注意：gitignore 规则不带行内注释（历史教训：行内中文注释导致规则不生效）
ssh-config.toml
.mcp.json
.zcode/

# 设计稿大文件（44MB+ 不随仓库分发，README 说明获取方式）
UI设计/
boke.pen
export.zip
